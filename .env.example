# 不要在此文件写真实密钥；复制为本机 .env 后填写，并确保 .env 不进入 Git。

EXPECTED_CONDA_ENV=unofficial-davinci-mcp-win
EXPECTED_PYTHON_VERSION=3.10.20

MULTIMODAL_PROVIDER=openai_compatible
MULTIMODAL_BASE_URL=https://your-openai-compatible-endpoint/v1
MULTIMODAL_API_KEY=<从本机安全配置读取>
MULTIMODAL_MODEL=gemini-3-flash
# 单段云端分析长度；实际上传前仍必须由项目明确授权。
MULTIMODAL_MAX_SEGMENT_SECONDS=30
MULTIMODAL_TIMEOUT_SECONDS=120

FUNASR_MANIFEST=./models/manifest.yaml
FUNASR_DEVICE=auto

# 使用已登录的本机 Codex App Server。不要在这里写 Token。
CODEX_APP_SERVER_COMMAND=codex
CODEX_RUNTIME_TIMEOUT_SECONDS=600
# CODEX_RUNTIME_MODEL=<留空则使用本机 Codex 默认模型>

CREATIVE_RAW_ROOT=C:\Users\13222\Nextcloud\达芬奇素材
CREATIVE_CERTIFIED_ROOT=C:\Users\13222\Nextcloud\达芬奇认证素材库
CREATIVE_CACHE_ROOT=./workspace/creative-cache

APP_DATA_ROOT=./workspace/data
WORKSPACE_ROOT=./workspace
RESOLVE_WORKSPACE_PROJECT=DavinciMcp_Workspace
